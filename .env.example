# Host bindings used by Docker Compose. Keep these on loopback unless the
# security consequences of exposing an outbound proxy are fully understood.
PROXY_BIND=127.0.0.1:8080
ADMIN_BIND=127.0.0.1:9090
PROMETHEUS_BIND=127.0.0.1:9091

# Container listeners. 0.0.0.0 is required inside the isolated container;
# published host ports remain restricted by the bindings above.
PROXY_ADDRESS=0.0.0.0:8080
ADMIN_ADDRESS=0.0.0.0:9090

TOR_SERVICE_NAME=tor
TOR_SOCKS_PORT=9050
DISCOVERY_INTERVAL=10s

LOAD_BALANCER=round_robin
CONNECT_TIMEOUT=15s
REQUEST_TIMEOUT=60s
IDLE_TIMEOUT=90s
HEADER_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

BACKEND_HEALTH_INTERVAL=10s
BACKEND_HEALTH_TIMEOUT=5s
BACKEND_FAILURE_THRESHOLD=3
BACKEND_SUCCESS_THRESHOLD=2
MAX_BACKEND_RETRIES=2

# Optional external check performed through each Tor backend. Leave disabled
# unless a stable endpoint under your control is available.
TOR_E2E_HEALTHCHECK_ENABLED=false
TOR_E2E_HEALTHCHECK_URL=

LOG_LEVEL=info
LOG_FORMAT=json

# Authentication is optional because Compose publishes the proxy on localhost.
PROXY_AUTH_ENABLED=false
PROXY_AUTH_USERNAME=
PROXY_AUTH_PASSWORD=

# Number of Tor replicas used by `make compose-up`.
TOR_REPLICAS=3
